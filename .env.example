# 이 파일을 복사해서 .env 를 만들고 실제 키를 넣으세요: cp .env.example .env
# https://platform.claude.com 의 API Keys 메뉴에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에_키를_붙여넣으세요

# (선택) 사용할 Claude 모델. 기본값 claude-sonnet-5-5 / 품질 우선이면 claude-opus-5-5
# AI_MODEL=claude-sonnet-5-5
# (실험) DeepSeek 우선 사용: deepseek 로 두면 DeepSeek로 먼저 요청하고, 결과 검사에 실패하면 Claude로 다시 요청
# 아래 DEEPSEEK_API_KEY 필요. 켜면 홈페이지 개인정보 안내 문구도 자동으로 바뀝니다.
# AI_PROVIDER=deepseek

# (선택) 서버 포트, 기본값 3000
# PORT=3000

# (선택) 사용량 제한 기본값
# RATE_LIMIT_PER_HOUR=20
# DAILY_LIMIT=300

# Upstash Redis - 공유 링크 저장 + 사용량 제한 (없으면 임시 메모리 저장)
# Vercel은 Storage 탭에서 연결하면 자동으로 들어갑니다. Render와 로컬에는 같은 값을 직접 넣으세요.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# (선택) 실제 장소 확인 + 지도 핀 표시 - 없으면 지도 없이 동작
# 국내: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키 (카카오맵 사용 설정 ON)
KAKAO_REST_API_KEY=
# 해외: Google Cloud Console → Places API (New) 사용 설정 → API 키
GOOGLE_MAPS_API_KEY=

# 관리자 사용량 페이지(/admin.html) 접속용 비밀번호 - 12자 이상 무작위 문자열
# 만들기: openssl rand -hex 16
ADMIN_TOKEN=

# (선택) IP 해시용 비밀값 - 없으면 Redis 토큰을 사용
# IP_HASH_SECRET=

# (선택) 모델 비교 실험용 - npm run compare
DEEPSEEK_API_KEY=
# 네이버 CLOVA Studio → API 키 메뉴에서 발급 (테스트 키로 충분)
CLOVASTUDIO_API_KEY=
# HCX-007 가격(1,000토큰당 원) — 기본값은 추정치이므로 요금표 확인 후 수정
# HCX_PRICE_IN_KRW_PER_1K=1.25
# HCX_PRICE_OUT_KRW_PER_1K=5
# Upstage 콘솔(console.upstage.ai) → API Keys
UPSTAGE_API_KEY=
