# 이 파일을 복사해서 .env 를 만들고 실제 키를 넣으세요: cp .env.example .env
# https://platform.claude.com 의 API Keys 메뉴에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에_키를_붙여넣으세요

# (선택) 서버 포트, 기본값 3000
# PORT=3000

# (선택) 사용량 제한 기본값
# RATE_LIMIT_PER_HOUR=20
# DAILY_LIMIT=300

# Upstash Redis - 공유 링크 저장 + 사용량 제한 (없으면 임시 메모리 저장)
# Vercel은 Storage 탭에서 연결하면 자동으로 들어갑니다. Render와 로컬에는 같은 값을 직접 넣으세요.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# (선택) 실제 장소 확인 + 지도 핀 표시 - 없으면 지도 없이 동작
# 국내: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키 (카카오맵 사용 설정 ON)
KAKAO_REST_API_KEY=
# 해외: Google Cloud Console → Places API (New) 사용 설정 → API 키
GOOGLE_MAPS_API_KEY=
